# Copy this file to ".env" and fill in your values. Never commit ".env".

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Replace <password> with your database user's password.
MONGODB_URI=mongodb+srv://nestroom_user:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=nestroom

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# Admin login (only one admin)

# Frontend address allowed to call the API ("*" = anyone; set your real site URL in production)
CORS_ORIGIN=*
PORT=3000

# First run only: fill the empty database with sample rooms/bookings and demo owners (meera / arjun)
SEED_DEMO_DATA=true
DEMO_OWNER_PASSWORD=Owner@123
